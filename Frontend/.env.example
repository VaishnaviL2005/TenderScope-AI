# ---------------------------------------------------------------------------
# TenderScope AI frontend environment
#
# SECURITY: every VITE_* variable is compiled into the public JavaScript bundle
# and can be read by anyone who opens the site. Never put secrets here:
# no database URLs, LLM / API keys, object-storage credentials or JWT secrets.
# Those belong only in the FastAPI backend's own environment.
# ---------------------------------------------------------------------------

# Base URL for every API call (no trailing slash). Relative or absolute.
#   Local development (recommended):  /api/v1
#       -> requests go to the Vite dev server, which proxies them to DEV_PROXY_TARGET.
#   Deployed, same origin:            /api/v1
#       -> your web server / reverse proxy must route /api/v1 to FastAPI.
#   Deployed, separate backend host:  https://api.your-domain.com/api/v1
#       -> the backend CORS list must include the frontend origin.
# This value is baked in at build time: rebuild after changing it.
VITE_API_BASE_URL=/api/v1

# LOCAL DEVELOPMENT ONLY. Read by vite.config.ts (not exposed to the browser).
# Where `npm run dev` / `npm run preview` forward /api/v1/* requests.
# Has no effect on a production build served by another web server.
DEV_PROXY_TARGET=http://127.0.0.1:8000
